{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "endurance-one-strava",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "vars": {
    "FRONTEND_URL": "https://toma1203.github.io/endurance-one-training/"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STRAVA_STATE",
        "class_name": "StravaState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StravaState"]
    }
  ],
  "observability": {
    "enabled": true
  }
}